	if:!shieldseen
		msg:Sul fondo della piscina ormai asciutta vedi uno scudo
		put:shield,$here
		set:shieldseen
	else
		ifobjin:shield,$here
			msg:Sul fondo della piscina ormai asciutta vedi uno scudo
		else
			msg:Non c'e' nulla di interessante
	else
else
	msg:Nella piscina, dove l'acqua e' piu' libera dal ghiaccio, qualcosa luccica

