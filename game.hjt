dt=Text
<node>
withobj:protect
5
ifobjin:stoneofdestiny,$inventory
	if:!protect
		addvar:magicwords,1
		set:protect
	if:magicwords=3		
		msg:Something around you starts to tremble!
		goto:_end
	else
		msg:You pronounced the last magic word in the wrong order! The room collapses.
		goto:_dead
else
	msg:You have to take the Stone of Destiny first

<end node> 5P9i0s8y19Z
