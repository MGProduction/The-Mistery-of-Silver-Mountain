dt=Text
<node>
withobj:rope
5
ifobjin:rope,$available
	if:ropetied
		msg:It's already tied
	else
		msg:You tie the rope to the well
		ifobjin:rope,$inventory
			if:weight>0
				decvar:weight,1
		put:rope,$here
		set:ropetied

<end node> 5P9i0s8y19Z
dt=Text
<node>
climb
4
<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:sheet
5
ifobjin:sheet,$available
	if:sheettied
		msg:You descend into the well slowly attached to the sheet, but it rips just before you have reached the bottom.
		put:sheet,$nowhere
		goto:dampwellbottom

<end node> 5P9i0s8y19Z
dt=Text
<node>
withobj:rope
5
ifobjin:rope,$available
	if:ropetied
		msg:You descend into the well slowly attached to the rope.
		goto:dampwellbottom

<end node> 5P9i0s8y19Z
