dt=Text
<node>
use
4
ifobjin:$this,$available
	ifobjin:boat,$available
		msg:You put the sheet on the boat as a sail
		put:sheet,$nowhere
		ifobjin:boat,$inventory
			put:boatwithsail,$inventory
			put:boat,$nowhere
		else
			put:boatwithsail,$here
			put:boat,$nowhere


<end node> 5P9i0s8y19Z
dt=Text
<node>
remove|take
4
ifobjin:boatwithsail,$available
	msg:You take the sheet back
	put:sheet,$inventory
	ifobjin:boatwithsail,$inventory
		put:boat,$inventory
		put:boatwithsail,$nowhere
	else
		put:boat,$here
		put:boatwithsail,$nowhere


