dt=Text
<node>
onenter
2
clear
ifundef:$room.shortdesc
	msg:Ti trovi in +
	msg:$roomname
else
	msg:Ti trovi +
	msg:$room.shortdesc
endif
msg:.
ifundef:$room.exits
	msg:Non ci sono uscite evidenti.
else
	msg:Ci sono uscite verso +
	msg:$room.exits
	msg:.
endif
ifobjinattr:$any,$here,visible+listable
	msg:Vedi: +
	listobjin:$here,visible+listable

