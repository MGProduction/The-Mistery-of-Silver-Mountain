dt=Text
<node>
withobj:$every
3
ifobjin:$this,$inventory
	ifobj:$this,takeable+visible
		putobj:$this,$here
		msg:Lasciato
		if:weight>0
			decvar:weight,1
	else
		msg:Non puoi lasciarlo
else
	msg:Non ce l'hai

<end node> 5P9i0s8y19Z
