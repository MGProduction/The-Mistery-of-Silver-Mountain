dt=Text
<node>
withobj:$every
3
ifobjinattr:$this,$here,visible
	ifobj:$this,takeable		
		setcount:weight,$inventory,takeable+large
		addvar:weight,1
		if:weight<maxweight
			putobj:$this,$inventory			
			msg:Fatto
		else
			msg:Porti gia' troppo peso per prendere anche questo oggetto
		endif
	else
		msg:Non vuoi farlo
else
	ifobjin:$this,$inventory
		msg:Ce l'hai gia'
	else
		msg:Non lo vedi qui

<end node> 5P9i0s8y19Z
